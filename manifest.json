{
  "manifest_version": 3,
  "name": "LinkedIn Job Scraper",
  "version": "1.0.0",
     "icons": {
     "16": "icons/icon16.png",
     "48": "icons/icon48.png",
     "128": "icons/icon128.png"
   },
  "description": "Search LinkedIn's public job listings by title and location, filter out senior roles, and view the results in a table.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Job Scraper"
  },
     "permissions": ["storage", "unlimitedStorage"],
      "host_permissions": [
        "https://www.linkedin.com/jobs-guest/*",
        "https://www.gov.uk/*",
        "https://assets.publishing.service.gov.uk/*"
   ]
}